# gen_icon_header.cmake — вшивает numeral_games.png в заголовок icon_data.h (base64)
if(NOT PNG OR NOT OUT)
    message(FATAL_ERROR "gen_icon_header.cmake: нужны -DPNG=<файл> -DOUT=<заголовок>")
endif()

file(READ "${PNG}" png_raw HEX)
string(LENGTH "${png_raw}" hexlen)
math(EXPR nbytes "${hexlen} / 2")

# побайтовый base64 без внешних зависимостей
set(b64chars "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
set(out "")
math(EXPR last "${nbytes} - 1")
set(i 0)
while(i LESS nbytes)
    math(EXPR i0 "${i} * 2")
    string(SUBSTRING "${png_raw}" ${i0} 2 b0)
    # b1, b2 (с дополнением нулями если не хватает байт)
    set(v1 0)
    set(v2 0)
    if(i LESS last)
        math(EXPR i1 "${i0} + 2")
        string(SUBSTRING "${png_raw}" ${i1} 2 b1)
        math(EXPR ib1 "0x${b1}")
        set(v1 ${ib1})
        math(EXPR imid "${i} + 1")
        if(imid LESS last)
            math(EXPR i2 "${i0} + 4")
            string(SUBSTRING "${png_raw}" ${i2} 2 b2)
            math(EXPR ib2 "0x${b2}")
            set(v2 ${ib2})
        endif()
    endif()
    math(EXPR ib0 "0x${b0}")
    math(EXPR triple "${ib0} * 65536 + ${v1} * 256 + ${v2}")
    math(EXPR c0 "${triple} / 262144")
    math(EXPR r1 "${triple} % 262144")
    math(EXPR c1 "${r1} / 4096")
    math(EXPR r2 "${r1} % 4096")
    math(EXPR c2 "${r2} / 64")
    math(EXPR c3 "${r2} % 64")
    string(SUBSTRING "${b64chars}" ${c0} 1 s0)
    string(SUBSTRING "${b64chars}" ${c1} 1 s1)
    math(EXPR imid "${i} + 1")
    if(imid LESS nbytes)
        string(SUBSTRING "${b64chars}" ${c2} 1 s2)
        set(tail "${s0}${s1}${s2}")
        math(EXPR ilast "${i} + 2")
        if(ilast LESS nbytes)
            string(SUBSTRING "${b64chars}" ${c3} 1 s3)
            string(APPEND tail "${s3}")
        else()
            string(APPEND tail "=")
        endif()
    else()
        string(APPEND tail "==")
    endif()
    string(APPEND out "${tail}")
    math(EXPR i "${i} + 3")
endwhile()

# режем на строки по 960 символов
string(LENGTH "${out}" len)
set(chunk_size 960)
set(i 0)
set(chunks "")
while(i LESS len)
    string(SUBSTRING "${out}" ${i} ${chunk_size} part)
    string(APPEND chunks "\"${part}\"\n    ")
    math(EXPR i "${i} + ${chunk_size}")
endwhile()

get_filename_component(_name "${PNG}" NAME)
file(WRITE "${OUT}"
"// Автогенерация (cmake/gen_icon_header.cmake) из ${_name}. Не редактировать вручную.\n#pragma once\nstatic const char ICON_PNG_BASE64[] =\n    ${chunks};\n")
